
<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">@Localizer["Home"]</MudNavLink>
    <AuthorizeView Roles="SAdm,Admi">
        <Authorized>

            <MudNavGroup Title="@Localizer["Setting"]" Icon="@Icons.Material.Filled.Settings" Expanded="false">
                <MudNavLink Href="users" Icon="@Icons.Material.Filled.People" IconColor="Color.Success"> @Localizer["Users"]</MudNavLink>
                <MudDivider Class="my-2" DividerType="DividerType.Middle" />
                <MudNavLink Href="Categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category"> @Localizer["Categories"]</MudNavLink>
                <MudNavLink Href="groups" Icon="@Icons.Material.Filled.Group" IconColor="Color.Primary"> @Localizer["Groups"]</MudNavLink>
                <MudNavLink Href="charges" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CreditCard" IconColor="Color.Info"> @Localizer["Charges"]</MudNavLink>
                <MudDivider Class="my-2" DividerType="DividerType.Middle" />
                <MudNavLink Href="conventions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CreditCard" IconColor="Color.Warning"> @Localizer["Convention"]</MudNavLink>
                <MudNavLink Href="ConventionValues" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Cottage" IconColor="Color.Primary"> @Localizer["ConventionValues"]</MudNavLink>
                <MudDivider Class="my-2" DividerType="DividerType.Middle" />
                <MudNavLink Href="laborremunerationparameterss" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Crib" IconColor="Color.Success"> @Localizer["LaborRemunerationParameterss"]</MudNavLink>
                <MudNavLink Href="laborremunerationparametersvalues" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FoodBank" IconColor="Color.Secondary"> @Localizer["LaborRemunerationParameterValues"]</MudNavLink>
                <MudNavLink Href="payrollconcepts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Payment" IconColor="Color.Warning"> @Localizer["PayrollConcepts"]</MudNavLink>
             </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="work,SAdm">
        <Authorized>
            <MudNavGroup Title="@Localizer["Processes"]" Expanded="false">
                <MudNavLink Href="payrollsettlements" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Payment" IconColor="Color.Warning"> @Localizer["Payrollsettlements"]</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

</MudNavMenu>


