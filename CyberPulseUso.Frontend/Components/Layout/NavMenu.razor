                           Size="Size.Small"
                           Style="margin-left: 24px; font-size: 0.75rem;text-transform: none;"
                           OnClick="GenerarReportePivotAsync">
                    Remuneración laboral
                </MudButton>
 *@             </MudNavGroup>

        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="SAdm,Admi,work">
        <Authorized>
            <MudNavGroup Title="@Localizer["Processes"]" Expanded="false" Icon="@Icons.Material.Filled.Memory">
                <MudNavLink Href="payrollsettlements" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Approval" IconColor="Color.Warning"> @Localizer["Payrollsettlements"]</MudNavLink>

                <MudNavLink Href="normatives" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountTree" IconColor="Color.Success">Visor Doc Normativos</MudNavLink>
            </MudNavGroup>
