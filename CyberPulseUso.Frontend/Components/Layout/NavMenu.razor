                <MudDivider Class="my-2" DividerType="DividerType.Middle" />
                <MudNavLink Href="conventions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CreditCard" IconColor="Color.Warning"> @Localizer["Convention"]</MudNavLink>
                <MudNavLink Href="ConventionValues" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Cottage" IconColor="Color.Primary"> @Localizer["ConventionValues"]</MudNavLink>
                <MudDivider Class="my-2" DividerType="DividerType.Middle" />
                <MudNavLink Href="laborremunerationparameterss" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Crib" IconColor="Color.Success"> @Localizer["LaborRemunerationParameterss"]</MudNavLink>

                <MudNavLink Href="laborremunerationparametersvalues" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FoodBank" IconColor="Color.Secondary"> @Localizer["LaborRemunerationParametersValue"]</MudNavLink>
                <MudNavLink Href="payrollconcepts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Approval" IconColor="Color.Warning"> @Localizer["PayrollConcepts"]</MudNavLink>
                <MudNavLink Href="laborremunerationparametersothervalues" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FoodBank" IconColor="Color.Secondary"> @Localizer["laborremunerationparametersothervalues"]</MudNavLink>
             </MudNavGroup>

             <MudNavGroup Title="@Localizer["Reports"]" Icon="@Icons.Material.Filled.Settings" Expanded="false">

                <MudNavLink Href="laborremunerationreport"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.PictureAsPdf"
                            IconColor="Color.Error">
                    Remuneración laboral
                </MudNavLink>

