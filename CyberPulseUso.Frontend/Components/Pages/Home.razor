@page "/"
@using CyberPulseUso.Frontend.Components.Pages.Lnpa.Dashboard
<PageTitle>Inicio</PageTitle>

<AuthorizeView>
    <Authorized>
        <Dashboard />
    </Authorized>

    <NotAuthorized>
        <div class="home-welcome-container">
            <div class="home-welcome-content">

                <MudText Typo="Typo.h4" Align="Align.Center">
                    USO – Regional Arauca
                </MudText>

                <MudText Typo="Typo.h5" Align="Align.Center">
                    Sistema de Liquidación de Nómina Parcial
                </MudText>

                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Gestión y consulta de liquidaciones laborales
                </MudText>

                <img src="Images/images.jpg"
                     alt="Logo USO"
                     class="home-welcome-logo" />

            </div>
        </div>
    </NotAuthorized>

    <Authorizing>
        <div class="home-welcome-container">
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />
        </div>
    </Authorizing>
</AuthorizeView>