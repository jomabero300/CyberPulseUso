@if (payrollSettlementDTO is null)
{
	<Loading />
}
else
{
	<MudDialog>

        <TitleContent>
            <div class="payroll-dialog-title">
                <MudText Typo="Typo.h6">
                    @DialogTitle
                </MudText>

                <MudText Typo="Typo.subtitle2" Class="charge-title">
                    @ChargeName
                </MudText>

                <MudText Typo="Typo.subtitle2" Class="operator-title">
                    @OperatorName
                </MudText>
            </div>
        </TitleContent>


        <DialogContent>
            <PayrollSettlementForm 
                @ref="PayrollSettlementForm"
                PayrollSettlementDTO="@payrollSettlementDTO"
                OnValidSubmit="EditAsync"
                ReturnAction="Return" />
        </DialogContent>
	</MudDialog>
}
