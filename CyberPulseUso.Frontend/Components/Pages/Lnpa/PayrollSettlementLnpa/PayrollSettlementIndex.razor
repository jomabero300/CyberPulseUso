@page "/payrollsettlements"

<AuthorizeView Roles="Admi,SAdm,work">
    <Authorized>

        @if (loading)
        {
            <Loading />
        }
        else
        {
            <MudTable Items="@PayrollSettlements"
                      @ref="table"
                      ServerData="LoadListAsync"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      FixedHeader="true"
                      FixedFooter="true"
                      Context="model">
                <ToolBarContent>
                    <div class="d-flex justify-content-between">
                        <MudText Typo="Typo.h6" Class="me-4"> @Localizer["PayrollSettlement"]</MudText>
                        <MudButton Variant="Variant.Outlined"
                                   EndIcon="@Icons.Material.Filled.Add"
                                   Color="Color.Info" OnClick="@(() => ShowModalAsync())">
                            @Localizer["New"]
                        </MudButton>
                    </div>
                    <MudSpacer />
                    <FilterComponent ApplyFilter="SetFilterValue" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>@Localizer["PayrollSettlement"]</MudTh>
                    <MudTh>@Localizer["Statu"]</MudTh>
                    <MudTh Class="text-center">@Localizer["Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@model.Amount</MudTd>
                    <MudTd>@model.Statu!.Name</MudTd>
                    <MudTd Class="text-center">
                        <MudTooltip Text="@Localizer["Edit"]">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       OnClick="@(() => ShowModalAsync(model.Id, true))">
                                <MudIcon Icon="@Icons.Material.Filled.Edit" />
                            </MudButton>
                        </MudTooltip>
                        <MudTooltip Text="@Localizer["Delete"]">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(@model))">
                                <MudIcon Icon="@Icons.Material.Filled.Delete" />
                            </MudButton>
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>@Localizer["NoRecords"]</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager RowsPerPageString=@Localizer["RecordsNumber"]
                                   PageSizeOptions="pageSizeOptions"
                                   AllItemsText=@Localizer["All"]
                                   InfoFormat="@infoFormat" />
                </PagerContent>
            </MudTable>
        }
    </Authorized>
</AuthorizeView>
