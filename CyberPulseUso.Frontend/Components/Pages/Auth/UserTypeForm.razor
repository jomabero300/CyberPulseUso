<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">

	<DataAnnotationsValidator />

	<MudTextField Label="@Localizer["Name"]"
				  Disabled="true"
				  Value="@user.FullName"
				  For="@(() => user.FullName)"
				  class="mb-3" />
	@* Value="@($"{user.FirstName} {user.LastName}")" *@

	<MudSelect T="UserType" @bind-Value="@user.UserType" Label="Tipo">
		@foreach (UserType tipo in Enum.GetValues(typeof(UserType)))
		{
			<MudSelectItem Value="@tipo">@tipo.GetDisplayName()</MudSelectItem>
		}
	</MudSelect>
	
	<MudButton  class="mt-5"
		Variant="Variant.Outlined"
			   StartIcon="@Icons.Material.Filled.ArrowBack"
			   Color="Color.Info"
			   OnClick="ReturnAction">
		@Localizer["Return"]
	</MudButton>

	<MudButton class="mt-5" Variant="Variant.Outlined"
			   StartIcon="@Icons.Material.Filled.Check"
			   Color="Color.Primary"
			   ButtonType="ButtonType.Submit">
		@Localizer["SaveChanges"]
	</MudButton>
</EditForm>