<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberPulseUso.Mobile.Views.Lnpa.ConventionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Convenios">

    <Grid Padding="15"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="12">

        <!-- Encabezado -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="8">

            <Label Text="Gestión de convenios"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>

            <ImageButton Grid.Column="1"
                         Source="icon_pdf.svg"
                         Style="{StaticResource IconButtonBase}"
                         Clicked="OnExportPdfClicked"
                         ToolTipProperties.Text="Exportar PDF"/>

            <ImageButton Grid.Column="2"
                         Source="icon_excel.svg"
                         Style="{StaticResource IconButtonBase}"
                         Clicked="OnExportExcelClicked"
                         ToolTipProperties.Text="Exportar Excel"/>

            <ImageButton Grid.Column="3"
                         Source="icon_add.svg"
                         Style="{StaticResource IconButtonBase}"
                         Clicked="OnCreateClicked"
                         ToolTipProperties.Text="Nuevo convenio"/>
        </Grid>

        <!-- Búsqueda -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">

            <Entry Placeholder="Buscar convenio..."
                   Text="{Binding Filter}"
                   ReturnType="Search"
                   ReturnCommand="{Binding SearchCommand}"/>

            <ImageButton Grid.Column="1"
                         Source="icon_search.svg"
                         Style="{StaticResource IconButtonBase}"
                         Clicked="OnSearchClicked"/>
        </Grid>

        <!-- Listado -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Conventions}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="No hay convenios para mostrar."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Gray"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12"
                            Margin="0,4"
                            Stroke="#DDDDDD"
                            StrokeThickness="1">

                        <Grid ColumnDefinitions="*,Auto,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="8"
                              RowSpacing="4">

                            <Label Text="{Binding Name}"
                                   FontSize="17"
                                   FontAttributes="Bold"/>

                            <Label Grid.Row="1"
                                   Text="{Binding Statu.Name,
                                                  StringFormat='Estado: {0}'}"
                                   FontSize="13"
                                   TextColor="Gray"/>

                            <ImageButton Grid.Column="1"
                                         Grid.RowSpan="2"
                                         Source="icon_edit.svg"
                                         Style="{StaticResource IconButtonBase}"
                                         VerticalOptions="Center"
                                         Clicked="OnEditClicked"
                                         CommandParameter="{Binding .}"/>

                            <ImageButton Grid.Column="2"
                                         Grid.RowSpan="2"
                                         Source="icon_delete.svg"
                                         Style="{StaticResource IconButtonBase}"
                                         VerticalOptions="Center"
                                         Clicked="OnDeleteClicked"
                                         CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Paginación -->
        <HorizontalStackLayout
            Grid.Row="3"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="15">

            <ImageButton
                Source="icon_previous.svg"
                Style="{StaticResource IconButtonBase}"
                Clicked="OnPreviousPageClicked"
                IsEnabled="{Binding CanGoPrevious}"
                ToolTipProperties.Text="Página anterior" />

            <Label
                Text="{Binding Page, StringFormat='{}{0}'}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                FontAttributes="Bold" />

            <Label
                Text="de"
                VerticalOptions="Center" />

            <Label
                Text="{Binding TotalPages}"
                VerticalOptions="Center"
                FontAttributes="Bold" />

            <ImageButton
                Source="icon_next.svg"
                Style="{StaticResource IconButtonBase}"
                Clicked="OnNextPageClicked"
                IsEnabled="{Binding CanGoNext}"
                ToolTipProperties.Text="Página siguiente" />

        </HorizontalStackLayout>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
    </Grid>
</ContentPage>
