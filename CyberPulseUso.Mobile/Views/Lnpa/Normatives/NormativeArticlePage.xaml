<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberPulseUso.Mobile.Views.Lnpa.Normatives.NormativeArticlePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Artículo">

    <Grid RowDefinitions="*,Auto" Padding="16">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="12">

                <Label
                    x:Name="LblNormative"
                    FontSize="14"
                    TextColor="Gray" />

                <Label
                    x:Name="LblChapter"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="Gray" />

                <Label
                    x:Name="LblTitle"
                    FontSize="21"
                    FontAttributes="Bold" />

                <Label
                    x:Name="LblDescription"
                    FontSize="15"
                    TextColor="Gray" />

                <BoxView HeightRequest="1"
                         BackgroundColor="Gray" />

                <Label
                    x:Name="LblContent"
                    FontSize="16"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>
        </ScrollView>

        <Button
            Grid.Row="1"
            Text="Regresar"
            Clicked="OnBackClicked"
            Margin="0,12,0,0" />

    </Grid>
</ContentPage>
