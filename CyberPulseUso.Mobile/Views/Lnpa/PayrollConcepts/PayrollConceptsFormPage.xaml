<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberPulseUso.Mobile.Views.Lnpa.PayrollConcepts.PayrollConceptsFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Concepto de nómina">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label
                x:Name="LblTitle"
                Text="Concepto de nómina"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Nombre" FontAttributes="Bold" />
                <Entry
                    x:Name="TxtName"
                    Placeholder="Ingrese el nombre del concepto"
                    MaxLength="80" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Estado" FontAttributes="Bold" />
                <Picker
                    x:Name="PkrStatus"
                    Title="Seleccione un estado"
                    ItemDisplayBinding="{Binding Name}" />
            </VerticalStackLayout>

            <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="25"
                    Margin="0,12,0,0">

                <ImageButton
                    Source="icon_save.svg"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    Aspect="AspectFit"
                    Clicked="OnSaveClicked"
                    SemanticProperties.Description="Guardar concepto" />

                <ImageButton
                    Source="icon_return.svg"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    Aspect="AspectFit"
                    Clicked="OnCancelClicked"
                    SemanticProperties.Description="Regresar" />

            </HorizontalStackLayout>
            <Label
                x:Name="LblError"
                TextColor="Red"
                IsVisible="False"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
