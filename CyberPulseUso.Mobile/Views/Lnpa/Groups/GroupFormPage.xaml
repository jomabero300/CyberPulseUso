<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberPulseUso.Mobile.Views.Lnpa.Groups.GroupFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Grupo">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label
                x:Name="LblTitle"
                Text="Grupo"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Nombre" FontAttributes="Bold" />
                <Entry
                    x:Name="TxtName"
                    Placeholder="Ingrese el nombre del grupo"
                    MaxLength="100" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Categoría" FontAttributes="Bold" />
                <Picker
                    x:Name="PkrCategory"
                    Title="-- Seleccionar Categoria --"
                    ItemDisplayBinding="{Binding Name}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Estado" FontAttributes="Bold" />
                <Picker
                    x:Name="PkrStatus"
                    Title="Seleccione un estado"
                    ItemDisplayBinding="{Binding Name}" />
            </VerticalStackLayout>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="25"
                Margin="0,12,0,0">

                <ImageButton
                    x:Name="BtnSave"
                    Source="icon_save.svg"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    Aspect="AspectFit"
                    Clicked="OnSaveClicked"
                    SemanticProperties.Description="Guardar grupo" />

                <ImageButton
                    Source="icon_return.svg"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    Aspect="AspectFit"
                    Clicked="OnCancelClicked"
                    SemanticProperties.Description="Regresar" />

            </HorizontalStackLayout>

            <HorizontalStackLayout
                x:Name="LayoutSaving"
                HorizontalOptions="Center"
                Spacing="8"
                IsVisible="False">

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsRunning="False"
                    WidthRequest="25"
                    HeightRequest="25" />

                <Label
                    Text="Guardando..."
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <Label
                x:Name="LblError"
                TextColor="Red"
                IsVisible="False"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
