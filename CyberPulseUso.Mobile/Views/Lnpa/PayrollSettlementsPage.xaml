<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberPulseUso.Mobile.Views.Lnpa.PayrollSettlementsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entities="clr-namespace:CyberPulseUso.Shared.Entities.Lnpa;assembly=CyberPulseUso.Shared"
    Title="Liquidaciones">

    <Grid Padding="15"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="10">

        <!-- Búsqueda -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">

            <SearchBar
                x:Name="SearchBar"
                Placeholder="Buscar por fecha, cargo o trabajador"
                Text="{Binding Filter}" />

            <Button
                Grid.Column="1"
                Text="Buscar"
                VerticalOptions="Center"
                Clicked="OnSearchClicked" />
        </Grid>

        <!-- Cargando -->
        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center" />

        <!-- Liquidaciones -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding PayrollSettlements}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="No hay liquidaciones para mostrar."
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="Gray" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:PayrollSettlement">

                    <Border
                        Stroke="#D6D6D6"
                        StrokeThickness="1"
                        Padding="12"
                        Margin="0,4"
                        StrokeShape="RoundRectangle 10">

                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="{Binding Charge.Name}"
                                    FontAttributes="Bold"
                                    FontSize="16" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Date, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                    FontSize="12"
                                    TextColor="Gray"
                                    VerticalOptions="Center" />
                            </Grid>

                            <Label
                                Text="{Binding User.FullName}"
                                FontSize="13"
                                TextColor="Gray"
                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                    Path=BindingContext.IsAdministrator}" />


                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">

                                <VerticalStackLayout>
                                    <Label Text="Devengado" FontSize="12" />
                                    <Label
                                        Text="{Binding AccruedValue, StringFormat='{0:N2}'}"
                                        FontAttributes="Bold" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Deducido" FontSize="12" />
                                    <Label
                                        Text="{Binding DeductedValue, StringFormat='{0:N2}'}"
                                        FontAttributes="Bold" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="Total a pagar" FontSize="12" />
                                    <Label
                                        Text="0.00"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        BindingContextChanged="OnTotalToPayBindingContextChanged" />
                                                            </VerticalStackLayout>

                            </Grid>
                            <!--<Grid ColumnDefinitions="*,*">                            
                                <VerticalStackLayout>
                                    <Label Text="Devengado" FontSize="12" />
                                    <Label
                                        Text="{Binding AccruedValue, StringFormat='{0:N2}'}"
                                        FontAttributes="Bold" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Deducido" FontSize="12" />
                                    <Label
                                        Text="{Binding DeductedValue, StringFormat='{0:N2}'}"
                                        FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>-->

                            <Grid ColumnDefinitions="*,Auto">

                                <!--<VerticalStackLayout>
                                    <Label Text="Total a pagar" FontSize="12" />
                                    <Label
                                        Text="0.00"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        BindingContextChanged="OnTotalToPayBindingContextChanged" />
                                </VerticalStackLayout>-->

                                <HorizontalStackLayout
                                    Grid.Column="1"
                                    Spacing="12"
                                    VerticalOptions="Center">



                                    <ImageButton
                                        Source="pdf.png"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        BackgroundColor="Transparent"
                                        Clicked="OnPdfClicked"
                                        CommandParameter="{Binding .}" />

                                </HorizontalStackLayout>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Paginación -->
        <Grid Grid.Row="3"
              ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Center">

            <Button
                Text="Anterior"
                Clicked="OnPreviousPageClicked" />

            <Label
                x:Name="PageInfoLabel"
                Grid.Column="1"
                Text="Página 1"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Button
                Text="Siguiente"
                Grid.Column="2"
                Clicked="OnNextPageClicked" />

        </Grid>

    </Grid>
</ContentPage>
