<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CyberPulseUso.Mobile.Views.ResendTokenPage"
    Title="Confirmar cuenta"
    BackgroundColor="#F5F7FB">

    <ScrollView>
        <VerticalStackLayout
            Padding="25,35"
            Spacing="20"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="8">
                <Label Text="USO - ARAUCA"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#2563EB"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Confirmar cuenta"
                       FontSize="25"
                       FontAttributes="Bold"
                       TextColor="#1E293B"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Ingresa tu correo electrónico y te enviaremos nuevamente el enlace de confirmación de tu cuenta."
                       FontSize="14"
                       TextColor="#64748B"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 15">

                <VerticalStackLayout Spacing="15">

                    <Label Text="Correo electrónico"
                           FontAttributes="Bold"
                           TextColor="#334155"/>

                    <Entry Placeholder="Ingresa tu correo electrónico"
                           Text="{Binding EmailData.Email}"
                           Keyboard="Email"
                           TextColor="#1E293B"/>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#DC2626"
                           FontSize="13"
                           HorizontalTextAlignment="Center"/>

                    <Button Text="Reenviar confirmación"
                            Command="{Binding ResendTokenCommand}"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="12"/>

                    <Button Text="Regresar al inicio de sesión"
                            Command="{Binding ReturnCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#2563EB"
                            FontAttributes="Bold"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
