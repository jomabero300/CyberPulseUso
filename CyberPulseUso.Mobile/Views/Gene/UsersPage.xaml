<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberPulseUso.Mobile.Views.Gene.UsersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Usuarios">

    <Grid Padding="15"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="12">

        <!-- Título -->
        <Label Grid.Row="0"
               Text="Gestión"
               FontSize="22"
               FontAttributes="Bold"
               VerticalOptions="Center" />

        <!-- Búsqueda y reportes -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="5">

            <Entry Grid.Column="0"
                   Placeholder="Buscar por nombre o correo..."
                   Text="{Binding Filter}"
                   ReturnType="Search"
                   Completed="OnSearchClicked" />

            <ImageButton Grid.Column="1"
                         Source="icon_search.svg"
                         Style="{StaticResource IconButtonBase}"
                         Clicked="OnSearchClicked"
                         ToolTipProperties.Text="Buscar" />

            <ImageButton Grid.Column="2"
                         Source="icon_pdf.svg"
                         Style="{StaticResource IconButtonBase}"
                         Clicked="OnExportPdfClicked"
                         ToolTipProperties.Text="Exportar PDF" />

            <ImageButton Grid.Column="3"
                         Source="icon_excel.svg"
                         Style="{StaticResource IconButtonBase}"
                         Clicked="OnExportExcelClicked"
                         ToolTipProperties.Text="Exportar Excel" />

        </Grid>

        <!-- Listado -->
        <Grid Grid.Row="2">

            <CollectionView ItemsSource="{Binding Users}"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20"
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="No se encontraron usuarios."
                               FontSize="16"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Padding="12"
                                Margin="0,0,0,10"
                                Stroke="#D0D0D0"
                                StrokeThickness="1">

                            <Grid ColumnDefinitions="75,*"
                                  ColumnSpacing="12">

                                <!-- Fotografía -->
                                <Border Grid.Column="0"
                                        WidthRequest="65"
                                        HeightRequest="65"
                                        StrokeShape="RoundRectangle 35"
                                        VerticalOptions="Center">

                                    <Image Source="{Binding Photo}"
                                           Aspect="AspectFill" />
                                </Border>

                                <!-- Información -->
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="5"
                                                         VerticalOptions="Center">

                                        <Label FontSize="17"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FirstName}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding LastName}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Label Text="{Binding Email}"
                                               FontSize="13"
                                               TextColor="Gray"
                                               LineBreakMode="TailTruncation" />

                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="Rol:"
                                                   FontAttributes="Bold" />

                                            <Label Text="{Binding UserType}"
                                                   TextColor="#1565C0"
                                                   FontAttributes="Bold" />
                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>

                                    <ImageButton Grid.Column="1"
                                                 Source="icon_edit.svg"
                                                 Style="{StaticResource IconButtonBase}"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End"
                                                 Clicked="OnChangeRoleClicked"
                                                 ToolTipProperties.Text="Cambiar rol" />

                                </Grid>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- Indicador de carga -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               BackgroundColor="#80FFFFFF" />

        </Grid>

        <!-- Paginación y errores -->
        <VerticalStackLayout Grid.Row="3"
                             Spacing="8">

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />

            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
      HorizontalOptions="Center">

                <ImageButton
        Grid.Column="0"
        Source="icon_previous.svg"
        Style="{StaticResource IconButtonBase}"
        Clicked="OnPreviousPageClicked"
        IsEnabled="{Binding CanGoPrevious}"
        ToolTipProperties.Text="Página anterior" />

                <Label Grid.Column="1"
           Text="{Binding Page}"
           FontAttributes="Bold"
           HorizontalTextAlignment="Center"
           VerticalTextAlignment="Center" />

                <Label Grid.Column="2"
           Text="de"
           HorizontalTextAlignment="Center"
           VerticalTextAlignment="Center"
           Margin="5,0" />

                <Label Grid.Column="3"
           Text="{Binding TotalPages}"
           FontAttributes="Bold"
           HorizontalTextAlignment="Center"
           VerticalTextAlignment="Center" />

                <ImageButton
        Grid.Column="4"
        Source="icon_next.svg"
        Style="{StaticResource IconButtonBase}"
        Clicked="OnNextPageClicked"
        IsEnabled="{Binding CanGoNext}"
        ToolTipProperties.Text="Página siguiente" />

            </Grid>

            <Label Text="{Binding TotalRecords, StringFormat='Total de usuarios: {0}'}"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>
